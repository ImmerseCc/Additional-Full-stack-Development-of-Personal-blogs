# 换行符统一策略（作者已同意新增本文件）
# 目的：消除 git 在 Windows 上的 "LF will be replaced by CRLF" 警告，保证跨平台一致
# 规则：仓库内文本文件统一以 LF 保存与检出；Windows 专用脚本保留 CRLF
* text=auto eol=lf

# Windows 批处理 / 命令脚本需要 CRLF，否则 cmd.exe 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本与 Maven Wrapper 必须 LF，否则在 Git Bash / Linux 下报 "bad interpreter"
*.sh  text eol=lf
mvnw   text eol=lf

# 二进制文件不参与换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text
*.woff binary
*.woff2 binary
*.db   binary
*.jar  binary
*.7z   binary
*.zip  binary
